# Copy to .env and fill in. Never commit real credentials.
#
# Instead of inline secrets you may use Docker secrets:
#   S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key
#   S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key

GATEWAY_PORT=8080
S3_ENDPOINT=https://de-fra.i3storage.com
S3_REGION=de-fra
S3_BUCKET=example-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only objects under this prefix are reachable. Empty means the whole bucket.
ALLOW_PREFIX=hls/
# Lifetime of a presigned URL. Every request mints a new one.
PRESIGN_TTL_SECONDS=300
