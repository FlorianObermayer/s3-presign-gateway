# Copy to .env and fill in. Never commit real credentials.
#
# Instead of inline secrets you may use Docker secrets:
#   S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key
#   S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key

GATEWAY_PORT=8080
S3_ENDPOINT=https://de-fra.i3storage.com
S3_REGION=de-fra
S3_BUCKET=example-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only objects under this prefix are reachable. Empty means the whole bucket.
ALLOW_PREFIX=hls/
# Lifetime of a presigned URL. Every request mints a new one.
PRESIGN_TTL_SECONDS=300

# Optional. A secret that must appear as the first path segment, e.g.
#   https://gateway.example.com/<token>/hls/0/segment.ts
# Generate one with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# Comma separate several tokens to rotate without downtime.
ACCESS_TOKENS=

# Simultaneous origins allowed to read the stream. Used by the gateway AND by
# the CORS setup task, so both sides always agree. Keep them in sync with the
# page that embeds the player, e.g. https://streaming.example.com
# Multiple origins are comma separated. Wildcards are not supported and are
# rejected at startup - list every subdomain explicitly.
CORS_ALLOWED_ORIGINS=*

# Only used by the one-shot CORS setup task (make cors), never by the gateway.
# This key needs PutBucketCors/GetBucketCors. Delete it again after setup.
S3_ADMIN_ACCESS_KEY_ID=
S3_ADMIN_SECRET_ACCESS_KEY=
